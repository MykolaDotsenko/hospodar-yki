  "typography": {
    "fallback": "system-ui, 'Segoe UI', Arial, sans-serif",
    "body_min_px": 16,
    "heading_weight": 750,
    "line_height": 1.5
  },
  "motion": {
    "micro_ms": 180,
    "max_ms": 250,
    "respect_reduced_motion": true
  },
  "a11y": {
    "target": "WCAG 2.2 AA",
    "validate_color_pairs": true,
    "no_color_only_feedback": true
  },
  "notes": [
    "Single source of truth: app/tokens.css is generated from this file (scripts/validate_design_tokens.py --write); declared contrast_pairs are CI-checked. Manual WCAG, screen-reader and device review are still required.",
    "Use educational content as product centerpiece, not decorative dashboards.",
    "No bundled proprietary font files.",
    "Iconography: single threshold H symbol in SVG on both learning and exam UI, not CSS letter H.",
    "Wordmark gold is decoration only; strong contrast text colors on paper.",
    "Do not imply government YKI endorsement; validate distinctiveness and trademark before launch.",
    "v0.3 builds a repeated screen-level threshold-route grammar, not only a new logo.",
    "User preferences permit colorful styling; avoid AI sameness and unsupported cognitive-science claims."
  ],
  "concept": "Поріг → Маршрут → Дія / Threshold → Route → Action",
  "asset": {
    "symbol": "assets/images/brand/hospodar-yki-mark.svg",
    "lockup": "assets/images/brand/hospodar-yki-lockup.svg",
    "mono": "assets/images/brand/hospodar-yki-mark-mono.svg",
    "min_icon_px": 24,
    "header_icon_px": 46
  },
  "mode_identity": {
    "learn": {
      "name_uk": "Навчання",
      "number": "01",
      "accent": "#31574C",
      "tint": "#EDF4EF",
      "tone": "supportive_adaptive"
    },
    "exam": {
      "name_uk": "Симуляція",
      "number": "02",
      "accent": "#083B7A",
      "tint": "#EDF2F8",
      "tone": "focused_independent"
    }
  },
  "component": {
    "mode_gateway": {
      "columns_desktop": 2,
      "columns_mobile": 2,
      "corner_signature": "soft asymmetric top-right 25 px",
      "gold_mark": "short diagonal",
      "hide_during_exam_session": true
    },
    "brand_header": {
      "same_svg_on_both_pages": true,
      "wordmark_label": "Hospodar YKI",
      "line": "Фінська для життя. Впевненість для YKI."
    }
  },
  "skill_identity": {
    "reading": {
      "accent": "#126D79",
      "icon": "book-open",
      "label_uk": "Читання",
      "name_fi": "Tekstin ymmärtäminen"
    },
    "listening": {
      "accent": "#694E9A",
      "icon": "headphones",
      "label_uk": "Аудіювання",
      "name_fi": "Puheen ymmärtäminen"
    },
    "writing": {
      "accent": "#985023",
      "icon": "pencil-line",
      "label_uk": "Письмо",
      "name_fi": "Kirjoittaminen"
    },
    "speaking": {
      "accent": "#247244",
      "icon": "mic",
      "label_uk": "Говоріння",
      "name_fi": "Puhuminen"
    }
  },
  "attention_design": {
    "allows_colorful": true,
    "purpose": [
      "clear hierarchy",
      "skill differentiation",
      "focused attention",
      "positive emotional tone"
    ],
    "restraint": "one primary highlighted action per step; neutral canvas around complex input",
    "calm_mode": "planned",
    "avoid_ai_sameness": [
      "default lilac-blue gradients",
      "glassmorphism",
      "floating gradient blobs",
      "generic repeated rounded cards",
      "stock mascots",
      "inconsistent AI-generated illustrations"
    ],
    "no_unverified_learning_claims": true,
    "not_color_only": true,
    "active_accents_per_task": 1,
    "visual_directions": [
      "threshold monogram",
      "short gold diagonal",
      "step route signature",
      "editorial real-life Finnish scenes"
    ],
    "contrast_regular_text_min": 4.5,
    "contrast_large_text_min": 3,
    "nontext_ui_min": 3,
    "target_size_min_css_px": 24,
    "primary_cta_min_height_css_px": 44,
    "proven_learning_effect": "NOT_ESTABLISHED",
    "breakpoints_qa_px": [
      320,
      360,
      390,
      768,
      1440
    ],
    "zoom_qa_percent": 200
  },
  "screen_signature": {
    "name": "ThresholdLine",
    "semantics": "actual steps in learn; actual modules in exam; never an inferred YKI score",
    "selected_shape": "horizontal arrow transition / diagonal threshold edge",
    "skip_unnecessary_step": true,
    "accessibility": "step labels and aria-valuenow or text; no color-only data",
    "training_color": "#31574C",
    "exam_color": "#083B7A",
    "visual_pattern": "one notable signature corner per screen rather than repetitive decorations"
  },
  "app_modes": {
    "learn": {
      "colorfulness": "more expressive but purposeful",
      "show_skill_and_progress": true,
      "feedback": "guided"
    },
    "exam": {
      "colorfulness": "calm exam focus",
      "hide_decoration_during_active": true,
      "feedback": "delayed"
    }
  },
  "qa": {
    "blind_logo_masking": "not yet done",
    "five_second_recognition": "not yet done",
    "wcag_manual": "not yet done",
    "trademark": "not yet done"
  },
