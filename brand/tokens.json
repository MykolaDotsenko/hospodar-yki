  "color_roles": {
    "rule": "DESIGN-01a: saturated colour is for orientation (navigation, mode gateway, skill identity, active route step, ONE primary action); Finnish text, writing fields, transcripts and the active exam sit on a calm neutral surface; answer cues appear only in the feedback phase.",
    "accent_layer": {
      "tokens": [
        "primary",
        "forest",
        "accent",
        "reading",
        "listening",
        "writing",
        "speaking"
      ],
      "allowed_for": [
        "navigation",
        "mode gateway",
        "skill badge/label/border",
        "active route segment",
        "single primary CTA",
        "focus ring (primary only)"
      ],
      "max_saturated_fills_per_task_screen": 1,
      "gold_is_decoration_only": true
    },
    "reading_surface": {
      "tokens": [
        "surface",
        "paper",
        "surface_subtle",
        "learn_tint",
        "exam_tint"
      ],
      "text_tokens": [
        "ink",
        "muted",
        "primary",
        "forest"
      ],
      "used_by": [
        "Finnish reading passage and prompt",
        "writing textarea",
        "answer inputs",
        "transcript",
        "active exam task"
      ],
      "css_selectors": [
        ".prompt",
        "textarea.answer",
        "input.answer",
        ".exam-textarea",
        ".answer-line"
      ]
    },
    "feedback_cue": {
      "tokens": [
        "cue_background",
        "cue_text"
      ],
      "phases": [
        "feedback"
      ],
      "css_selectors": [
        ".learning-cue"
      ]
    }
  },
