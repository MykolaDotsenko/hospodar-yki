      "status": "minimal_app_pilot"
    },
    {
      "id": "selective_form_noticing",
      "mode": "learn",
      "phase": "feedback",
      "rule": "At most one visible target cue per question, use underline + high-contrast color; only after independent answer",
      "why": [
        "schneider2018",
        "ma2026"
      ],
      "priority": "P0",
      "status": "already_in_app"
    },
    {
      "id": "unassisted_transfer",
      "mode": "learn",
      "phase": "transfer,retest",
      "rule": "No answer highlight during transfer/review or unseen test, keep first attempt accuracy separate",
      "why": [
        "karpicke2011",
        "leehuang2008"
      ],
      "priority": "P0",
      "status": "already_in_app"
    },
    {
      "id": "paired_color_correspondence",
      "mode": "learn",
      "phase": "optional_explanation",
      "rule": "If text/object or transcript/audio is independently verified and linked, show same small cue on both, plus explicit label; never randomly associate task colors with grammar categories",
      "why": [
        "ozcelik2009"
      ],
      "priority": "P1",
      "status": "future"
    },
    {
      "id": "synchronized_caption",
      "mode": "learn",
      "phase": "post_listening_feedback",
      "rule": "Allow transcript highlight only with reviewed verbatim VTT and user-initiated replay; no fake timings",
      "why": [
        "ozcelik2009",
        "ma2026"
      ],
      "priority": "P1",
      "status": "future"
    },
    {
      "id": "exam_fidelity_isolation",
      "mode": "exam",
      "phase": "attempt",
      "rule": "Remove all answer/meaning/grammar cues during exam attempt, allow only labeled functional mode navigation",
      "why": [
        "ma2026",
        "leehuang2008"
      ],
      "priority": "P0",
      "status": "existing_exam_no_cue"
    },
    {
      "id": "accessibility",
      "mode": "both",
      "phase": "all",
      "rule": "WCAG AA contrast, labels+patterns, reduced motion; calm option must not affect score or item bank",
      "why": [
        "wcagcolor2023"
      ],
      "priority": "P1",
      "status": "partial"
    }
