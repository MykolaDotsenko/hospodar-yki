  "policies": {
    "mode_learn": [
      "allow_feedback_after_attempt",
      "allow_hints_without_premature_key",
      "allow_teacher_reviewed_multimedia",
      "record_hint_use",
      "schedule_independent_retest"
    ],
    "mode_exam": [
      "hide_all_learning_hints_until_end",
      "do_not_reveal_answer_keys_during_attempt",
      "disable_mascot",
      "disable_karaoke_captions",
      "use_only_permitted_confirmed_exam_controls",
      "writing_speaking_ungraded_without_calibration"
    ],
    "interaction_lifecycle": [
      "prompt",
      "unassisted_response",
      "graded_objective_or_ungraded_open",
      "optional_hint_after_wrong",
      "self_repair",
      "feedback_meaning_before_form",
      "transfer_no_cue",
      "spaced_unseen_retest"
    ],
    "feedback_order": [
      "communicative_task_success",
      "one_or_two_high_priority_errors",
      "optional_form_details"
    ],
    "cue_policy": [
      "meaningful",
      "after_first_independent_attempt",
      "single_focus",
      "underlining_plus_text_not_color_only",
      "faded_for_transfer",
      "never_in_exam"
    ],
    "accessibility": [
      "WCAG_2_2_AA",
