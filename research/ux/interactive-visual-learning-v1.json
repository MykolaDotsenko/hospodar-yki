  "name": "Hospodar YKI interactive + visual learning: evidence and build contract",
  "target": "Adult A2.2 to B1/B1+ Finnish; all 4 YKI skills",
  "review_type": "targeted academic literature review; not PRISMA or app trial",
  "status": "requirements_only; do not infer feature completion",
  "rating_definition": "Expert product priority score /100 (evidence, transfer relevance, accessibility, implementation cost). NOT experimental effect, score improvement percentage, or YKI pass probability.",
  "limitations": [
    "Most experiments are not in Finnish or the digital YKI format.",
    "Immediate recognition does not establish 7/14-day productive transfer.",
    "Meta-analysis standardized g values are not improvement percentages.",
    "Experiments with images, captions or colors do not prove a specific Hospodar theme.",
    "Interactions, animations and gamification are not assumed beneficial without measured learning effects."
  ],
