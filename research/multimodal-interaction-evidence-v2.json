  "sources": [
    {
      "id": "V01",
      "title": "Mahdi et al. multimedia glosses 2024",
      "study_type": "meta of meta (7 reviews,136 studies)",
      "population": "L2",
      "url": "https://doi.org/10.1016/j.actpsy.2024.104341",
      "finding": "Gloss helpful especially recognition/beginners; single mode sometimes beats multi",
      "limitation": "Overlapping experiments and tests mainly recognition"
    },
    {
      "id": "V02",
      "title": "Kurokawa et al. captioned viewing 2025 issue",
      "study_type": "meta (49 studies,89 effects)",
      "population": "L2",
      "url": "https://doi.org/10.1111/lang.12697",
      "finding": "Captioned vocabulary g=.56",
      "limitation": "Listening without captions requires independent testing"
    },
    {
      "id": "V03",
      "title": "Li et al. embodied vocabulary 2026",
      "study_type": "meta (52 studies,442 analyzed effects)",
      "population": "vocabulary",
      "url": "https://doi.org/10.1007/s10648-026-10194-9",
      "finding": "Congruent actions matter, g=.65 between and .27 within designs",
      "limitation": "Publication bias detected; effects likely overestimated"
    },
    {
      "id": "V04",
      "title": "Gestures enactment versus observation 2023",
      "study_type": "meta (7 studies,N=309)",
      "population": "L2",
      "url": "https://doi.org/10.3390/bs13110920",
      "finding": "Observing meaningful gestures can be as good as acting",
      "limitation": "Small literature, mostly concrete words"
    },
    {
      "id": "V05",
      "title": "Leutner and Biele drawing to learn 2025",
      "study_type": "meta (14 studies,N=1213)",
      "population": "general",
      "url": "https://doi.org/10.1007/s10648-025-10067-7",
      "finding": "Support for meaningful integration g=.35; general drawing support no benefit",
      "limitation": "Mostly STEM, language application hypothesis"
    },
    {
      "id": "V06",
      "title": "Zhang et al. active video learning 2025",
      "study_type": "meta (46 articles,54 studies)",
      "population": "general",
      "url": "https://doi.org/10.1016/j.edurev.2025.100708",
      "finding": "Retention g=.33 comprehension .28 transfer .43 cognitive load .19",
      "limitation": "Mostly STEM; not all prompts useful"
    },
    {
      "id": "V07",
      "title": "Beege and Ploetzner interactive video 2024 online/2025 issue",
      "study_type": "experiment (N=128; time controlled)",
      "population": "general",
      "url": "https://doi.org/10.1007/s11251-024-09693-5",
      "finding": "Added prompts did not improve learning and raised cognitive load",
      "limitation": "One STEM context"
    },
    {
      "id": "V08",
      "title": "Liu et al. mobile language games 2025",
      "study_type": "meta (38 studies,N=4102)",
      "population": "L2 and L1",
      "url": "https://doi.org/10.1080/09588221.2025.2528786",
      "finding": "Pooled g=.962, particularly vocabulary and pronunciation",
      "limitation": "30/38 studied English targets; varied outcomes"
    },
    {
      "id": "V09",
      "title": "Zhou and Zhou mobile vocabulary 2025 online/2026 issue",
      "study_type": "bayesian meta (65 studies)",
      "population": "L2",
      "url": "https://doi.org/10.1017/S0958344025100335",
      "finding": "Long duration subgroup 10+ weeks reported 1.28 effect",
      "limitation": "Not an effect estimate for any mobile app"
    },
    {
      "id": "V10",
      "title": "Almusharraf et al. CAPT 2024",
      "study_type": "meta (31 studies,42 effects)",
      "population": "L2",
      "url": "https://doi.org/10.1111/jcal.12974",
      "finding": "Computer assisted pronunciation training positive on average",
      "limitation": "Does not validate Finnish auto-score"
    },
    {
      "id": "V11",
      "title": "Li et al. GenAI chatbots 2025",
      "study_type": "meta (41 studies,N=3515)",
      "population": "L2",
      "url": "https://doi.org/10.1111/jcal.70060",
      "finding": "Reported ES=.576 overall",
      "limitation": "No automatic YKI validity"
    },
    {
      "id": "V12",
      "title": "Wang et al. chatbot assisted language learning 2024 online/2025 issue",
      "study_type": "meta (28 studies,70 effects)",
      "population": "L2",
      "url": "https://doi.org/10.3102/00346543241255621",
      "finding": "g=.484; interface design matters",
      "limitation": "Errors in model feedback remain"
    },
    {
      "id": "V13",
      "title": "Zhang et al. split attention text and visuals 2024",
      "study_type": "experiment (N=146)",
      "population": "general",
      "url": "https://doi.org/10.1002/acp.4223",
      "finding": "Text/diagram arrangement and size studied",
