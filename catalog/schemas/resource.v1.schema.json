{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MykolaDotsenko/hospodar-yki/blob/main/catalog/schemas/resource.v1.schema.json",
  "title": "Hospodar YKI resource record V1 (future ingestion contract, not existing file validation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "status",
    "title",
    "languages",
    "source",
    "rights",
    "delivery",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,99}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "audio",
        "video",
        "youtube_link",
        "publisher_link",
        "official_reference",
        "knowledge_source",
        "dictionary",
        "exercise",
        "research",
        "design",
        "ux",
        "gameplay",
        "user_case"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review_required",
        "reviewed",
        "published_link_only",
        "published_licensed"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": {
        "enum": [
          "reading",
          "listening",
          "writing",
          "speaking"
        ]
      },
      "uniqueItems": true
    },
    "cefr_estimate": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "A1",
        "A2",
        "A2.2",
        "B1",
        "B1+",
        "B2",
        "C1",
        null
      ]
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "origin_url",
        "creator",
        "verified_at"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "project_original",
            "licensed_external",
            "youtube",
            "official_demo",
            "publisher",
            "academic_source",
            "unknown"
          ]
        },
        "origin_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "creator": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "official_yki": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_status",
        "redistribution_allowed",
        "attribution"
      ],
      "properties": {
        "license_status": {
          "enum": [
            "unverified",
            "licensed",
            "public_domain",
            "link_only"
          ]
        },
        "spdx_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "derivatives_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "link_only",
            "repository_source",
            "web_stream",
            "web_optional_offline",
            "android_install_time_pack"
          ]
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "pack_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alt_text_fi": {
          "type": [
            "string",
            "null"
          ]
        },
        "alt_text_uk": {
          "type": [
            "string",
            "null"
          ]
        },
        "decorative": {
          "type": "boolean"
        },
        "transcript_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "captions_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pedagogy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learning_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pedagogical_status",
        "rights_status"
      ],
      "properties": {
        "pedagogical_status": {
          "enum": [
            "pending",
            "human_reviewed",
            "not_applicable"
          ]
        },
        "rights_status": {
          "enum": [
            "pending",
            "verified",
            "link_only"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "youtube_link"
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "mode": {
                "const": "link_only"
              }
            }
          },
          "rights": {
            "properties": {
              "redistribution_allowed": {
                "const": false
              }
            }
          },
          "source": {
            "properties": {
              "source_type": {
                "const": "youtube"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "properties": {
              "mode": {
                "const": "android_install_time_pack"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rights": {
            "properties": {
              "redistribution_allowed": {
                "const": true
              },
              "license_status": {
                "enum": [
                  "licensed",
                  "public_domain"
                ]
              }
            }
          },
          "delivery": {
            "required": [
              "sha256",
              "pack_id",
              "local_path"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pack_id": {
                "type": "string",
                "minLength": 1
              },
              "local_path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "review": {
            "properties": {
              "rights_status": {
                "const": "verified"
              }
            }
          }
        }
      }
    }
  ]
}
